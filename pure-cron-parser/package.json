{
  "name": "pure-cron-parser",
  "version": "0.2.0",
  "description": "Zero-dependency cron parser and scheduler: computes the next run and arms a single setTimeout, no polling",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "cron",
    "scheduler",
    "cron-parser",
    "timezone",
    "zero-dependency"
  ],
  "license": "MIT"
}
